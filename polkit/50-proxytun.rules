// Members of the "proxytun" group may start/stop proxytun@*.service without a password
// (used by the GNOME Quick Settings toggle).
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units")
        return polkit.Result.NOT_HANDLED;
    var unit = action.lookup("unit") || "";
    var verb = action.lookup("verb") || "";
    if (/^proxytun@[A-Za-z0-9_-]+\.service$/.test(unit) &&
        ["start", "stop", "restart"].indexOf(verb) >= 0 &&
        subject.local && subject.active && subject.isInGroup("proxytun"))
        return polkit.Result.YES;
    return polkit.Result.NOT_HANDLED;
});
